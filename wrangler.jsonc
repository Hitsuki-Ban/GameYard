{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gameyard",
  "main": "./deployment/cloudflare-worker.mjs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/GameYard", "/GameYard/*"],
  },
  "env": {
    "preview": {
      "name": "gameyard-preview",
    },
    "production": {
      "name": "gameyard",
    },
  },
}
