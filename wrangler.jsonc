{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gameyard",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  "env": {
    "preview": {
      "name": "gameyard-preview",
    },
    "production": {
      "name": "gameyard",
    },
  },
}
