{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "guest/src/**/*",
    "build/**/*.mjs",
    "performance/**/*.ts",
    "playwright.baseline.config.ts",
    "playwright.runtime.config.ts",
    "tests/**/*.ts",
    "tools/**/*.mjs",
    "vite.config.ts",
    "vite.source.config.ts",
    "vite.testkit.config.ts"
  ],
  "references": [
    { "path": "../../packages/game-contract" },
    { "path": "../../packages/guest-bridge" },
    { "path": "../../packages/manifest-tools" }
  ]
}
