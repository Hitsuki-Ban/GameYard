{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "playwright.baseline.config.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vite.testkit.config.ts"
  ]
}
