{
  "name": "@gameyard/kamifuda-runner",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "browser:install": "vp exec playwright install chromium",
    "dev": "vp dev",
    "dev:testkit": "vp dev --config vite.testkit.config.ts",
    "build": "vp build",
    "build:testkit": "vp build --config vite.testkit.config.ts",
    "check": "vp check && vp exec node tools/verify-source-snapshot.mjs && vp run build && vp run build:testkit",
    "test": "vp run check && vp exec playwright test --config playwright.baseline.config.ts"
  },
  "dependencies": {
    "@gameyard/game-contract": "workspace:*",
    "@gameyard/guest-bridge": "workspace:*",
    "@gameyard/manifest-tools": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
